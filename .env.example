# Copy to .env and replace this development-only example before first start.
CRYPTO_LAB_DB_NAME=crypto_lab_local
CRYPTO_LAB_DB_USER=crypto_lab
CRYPTO_LAB_DB_PASSWORD=replace-with-a-local-password
CRYPTO_LAB_WEB_PORT=8080

# Public market data only. No API key or trading permission is used.
CRYPTO_LAB_FEED_ENABLED=true
CRYPTO_LAB_FEED_INSTRUMENTS=BTC/USDT,ETH/USDT
CRYPTO_LAB_FEED_CANDLE_INTERVALS=1m
